   "source": [
    "import ipytest, pytest\n",
    "ipytest.autoconfig(addopts=[\"-v\"])\n",
    "\n",
    "@pytest.mark.parametrize(\n",
    "    \"x, y\",\n",
    "    [\n",
    "        pytest.param(2, 3, id=\"small_numbers\"),\n",
    "        pytest.param(100, 200, id=\"large_numbers\")\n",
    "    ]\n",
    ")\n",
    "def test_addition(x, y):\n",
    "    assert x + y > 0\n",
    "\n",
    "ipytest.run(\"-v\")"
   ]
  },
